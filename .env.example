# Only needed for live LLM answers (not for `docqa demo` or `docqa evaluate`).
OPENAI_API_KEY=
DOCQA_MODEL=gpt-4.1-mini
DOCQA_EMBEDDING=hash
DOCQA_DOCS=docs/sample
DOCQA_TIMEOUT_SECONDS=20
# Optional, only if you want token spend estimates for the selected model.
DOCQA_INPUT_USD_PER_MILLION=
DOCQA_OUTPUT_USD_PER_MILLION=
